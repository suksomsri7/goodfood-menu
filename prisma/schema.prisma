generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id            String    @id @default(cuid())
  lineUserId    String?   @unique
  displayName   String?
  pictureUrl    String?
  name          String?
  email         String?
  phone         String?
  gender        String?
  birthDate     DateTime?
  height        Float?
  weight        Float?
  goalWeight    Float?
  goalType      String?
  activityLevel String?
  equipment     String? // none | home (ดัมเบล/ยางยืด) | gym — ใช้เลือกท่าออกกำลังกาย
  dietType      String?
  targetMonths  Int?
  bmr           Float?
  tdee          Float?
  dailyCalories Int?
  dailyProtein  Float?
  dailyCarbs    Float?
  dailyFat      Float?
  dailySodium   Float?
  dailySugar    Float?
  dailyWater    Float?
  /// ว่าง = คำนวณให้อัตโนมัติ 14 ก. ต่อ 1,000 kcal (เกณฑ์ DRI) — ใส่ค่าเองได้ถ้าหมอสั่ง
  dailyFiber    Float?
  memberTypeId  String?
  isOnboarded   Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Activity Status (inactive until onboarding completes, then active)
  activityStatus   String    @default("inactive") // "active" | "inactive"
  lastActiveAt     DateTime  @default(now())
  inactiveSince    DateTime?
  welcomeBackShown Boolean   @default(false)

  // AI Coach expire date (set by Admin)
  aiCoachExpireDate DateTime?

  // Notification Preferences
  notifyMorningCoach       Boolean   @default(true)
  notifyEveningSummary     Boolean   @default(true)
  notifyWeeklyInsights     Boolean   @default(true)
  notifyLunchSuggestion    Boolean   @default(true)
  notifyDinnerSuggestion   Boolean   @default(true)
  notifyWaterReminder      Boolean   @default(true)
  notifyProgressPhoto      Boolean   @default(true)
  notifyPostExercise       Boolean   @default(true)
  notifyWeightReminder     Boolean   @default(true)
  notifyArticles           Boolean   @default(true) // บทความสุขภาพที่ตรงกับพฤติกรรม (B2)
  // เพิ่มทีละ 1 ตอน logout — watch token ที่ออกก่อนหน้าจะมี epoch เก่าแล้วใช้ไม่ได้ทันที
  // (watch token อายุ 30 วันและไม่มีแถวใน DB จึงเพิกถอนรายใบไม่ได้แบบ refresh token)
  sessionEpoch             Int       @default(0)
  dailyBurnGoal            Int? // เป้าเผาผลาญ/วัน (kcal) ที่ user ตั้งเอง — ว่าง = ใช้ Move goal ของนาฬิกา/คำนวณให้
  notificationsPausedUntil DateTime?
  /// ยินยอมให้เก็บ/วิเคราะห์ภาพร่างกาย (WO-BODY §5 ข้อ 2) — ว่าง = ยังไม่ยินยอม → สแกนไม่ได้
  /// ครั้งเดียวพอ แต่ถอนได้ (เซ็ตกลับเป็น null) · ไม่มีค่านี้ = API สแกนตอบ 403 ทุกครั้ง
  bodyConsentAt            DateTime?

  addresses          Address[]
  aiRecommendation   AiRecommendation?
  cartItems          CartItem[]
  dailyPlans         DailyPlan[]
  exerciseLogs       ExerciseLog[]
  mealLogs           MealLog[]
  memberType         MemberType?         @relation(fields: [memberTypeId], references: [id])
  orders             Order[]
  progressPhotos     ProgressPhoto[]
  waterLogs          WaterLog[]
  weightLogs         WeightLog[]
  authIdentities     AuthIdentity[]
  deviceTokens       DeviceToken[]
  healthConnections  HealthConnection[]
  sleepLogs          SleepLog[]
  dailyMetrics       DailyMetric[]
  workoutSessions    WorkoutSession[]
  coachMemories      CoachMemory[]
  behaviorInsights   BehaviorInsight[]
  coachChatLogs      CoachChatLog[]
  coachNotifications CoachNotification[]
  refreshTokens      RefreshToken[]
  foodProfile        FoodProfile?
  mealPlanDesigns    MealPlanDesign[]
  mealSwaps          MealSwap[]
  enrollments        ProgramEnrollment[]
  memberEquipment    MemberEquipment[]
  setLogs            SetLog[]
  progressionStates  ProgressionState[]
  readinessCheckins  ReadinessCheckin[]
  todoSkips          TodoSkip[]
  foodStocks         MemberFoodStock[]
  bodyScans          BodyScan[]
  mealFeedbacks      MealFeedback[]
  bodyMeasurements   BodyMeasurement[]
  bodyGoals          BodyGoal[]
  bodyReports        BodyReport[]
  trainingProfile    TrainingProfile?
  injuryLimitations  InjuryLimitation[]

  @@map("members")
}

// ── Coach (native app) : Auth / identity ──
model AuthIdentity {
  id         String   @id @default(cuid())
  memberId   String
  provider   String // "apple" | "google" | "line"
  providerId String // sub / userId
  email      String?
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([memberId])
  @@map("auth_identities")
}

// ── Coach : refresh token ที่ track ได้ (S3 — rotate ทุกครั้งที่ใช้ + เพิกถอนได้) ──
model RefreshToken {
  id         String    @id // = jti ใน JWT
  memberId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String? // jti ตัวใหม่ที่ rotate ไป (ไว้ตรวจ reuse)
  createdAt  DateTime  @default(now())
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(cuid())
  memberId  String
  platform  String // "ios" | "android"
  token     String   @unique // Expo push token / APNs / FCM
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("device_tokens")
}

// ── Coach : Health sync ──
model SleepLog {
  id            String    @id @default(cuid())
  memberId      String
  date          DateTime // BKK date key ของคืนที่ตื่น
  minutesAsleep Int
  quality       Float?
  stages        Json? // {deep,rem,core,awake} นาที
  // เวลาเข้านอน/ตื่นจริง — ใช้ดู "ความสม่ำเสมอของเวลานอน" ซึ่งสัมพันธ์กับการลดน้ำหนักมาก
  // (เก็บเป็น instant จริง ไม่ใช่แค่จำนวนนาที · null = แหล่งข้อมูลไม่ได้บอกเวลา เช่นที่ user พูดเอง)
  startAt       DateTime?
  endAt         DateTime?
  source        String    @default("healthkit")
  sourceId      String?
  createdAt     DateTime  @default(now())
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date, source])
  @@index([memberId, date])
  @@map("sleep_logs")
}

model DailyMetric {
  id          String   @id @default(cuid())
  memberId    String
  date        DateTime
  steps       Int?
  restingHR   Int?
  activeKcal  Int?
  standHours  Int? // ชั่วโมงที่ลุกยืน (วง Stand ของ Apple — มาจาก Watch เท่านั้น)
  exerciseMin Int? // นาทีออกกำลังกาย (วง Exercise)
  moveGoal    Int? // เป้าวง Move ของวันนั้นที่ user ตั้งไว้บนนาฬิกา (kcal) — Apple ให้เปลี่ยนได้รายวัน

  // ── ตัวชี้วัดเชิงลึกจาก Apple Watch (เพิ่ม 13 ส.ค. 2026 · ทุกตัว nullable = ไม่มีก็ไม่เป็นไร) ──
  // เก็บเป็นคอลัมน์จริงไม่ใช่ JSON เพราะต้องทำกราฟ/ค่าเฉลี่ย/เทรนด์ด้วย SQL
  hrvMs           Float? // HRV SDNN (ms) — ตัวชี้ความเครียด/การฟื้นตัวที่ดีที่สุดที่ Watch ให้
  vo2max          Float? // ml/kg/min — ระดับฟิตของหัวใจ (Watch ประเมินให้เอง)
  hrRecovery      Int? // ชีพจรที่ลดลงใน 1 นาทีหลังจบการออกกำลังกาย (ยิ่งมากยิ่งฟิต)
  respiratoryRate Float? // ครั้ง/นาที (วัดขณะหลับ)
  spo2            Float? // ออกซิเจนในเลือด 0-1
  wristTempDelta  Float? // อุณหภูมิข้อมือขณะหลับ เทียบ baseline ของตัวเอง (°C · Apple ให้เป็นส่วนต่าง)
  breathDisturb   Float? // สัดส่วนการหายใจผิดปกติขณะหลับ 0-1
  distanceM       Int? // ระยะทางเดิน+วิ่ง (เมตร)
  flights         Int? // จำนวนชั้นบันไดที่ขึ้น
  daylightMin     Int? // เวลาอยู่กลางแดด (นาที)
  walkingSpeed    Float? // ความเร็วเดินเฉลี่ย (กม./ชม.)
  basalKcal       Int? // พลังงานพื้นฐานที่ Watch วัดได้ — เอาไปเทียบกับ TDEE ที่เราคำนวณ
  bodyFatPct      Float? // % ไขมัน (ต้องมีเครื่องชั่งอัจฉริยะ)
  leanMassKg      Float? // มวลไร้ไขมัน (กก.)
  mindfulMin      Int? // นาทีทำสมาธิ
  audioDb         Float? // ระดับเสียงรอบตัวเฉลี่ย (dBA)

  source    String   @default("healthkit")
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date, source])
  @@index([memberId, date])
  @@map("daily_metrics")
}

// ── Coach : Live workout (realtime) ──
model WorkoutSession {
  id            String    @id @default(cuid())
  memberId      String
  startedAt     DateTime
  endedAt       DateTime?
  type          String // run|walk|bike|strength|...
  avgHR         Int?
  maxHR         Int?
  kcal          Int?
  distanceM     Int?
  nudges        Json? // [{tAt, text, kind}]
  exerciseLogId String?
  createdAt     DateTime  @default(now())
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, startedAt])
  @@map("workout_sessions")
}

// ── Coach : Personalization (จำพฤติกรรมเฉพาะตัว user) ──
model CoachMemory {
  id         String   @id @default(cuid())
  memberId   String
  kind       String // preference | pattern | constraint | goal_note | dislike | injury | schedule | context
  fact       String
  confidence Float    @default(0.6)
  source     String // "chat" | "log_pattern" | "onboarding" | "user_stated"
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, kind, active])
  @@map("coach_memories")
}

// ── Coach : บทสนทนาเสียง (เก็บ backend ไม่แสดงใน UI — Siri style) ──
model CoachChatLog {
  id        String   @id @default(cuid())
  memberId  String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("coach_chat_logs")
}

// ── Coach : ศูนย์แจ้งเตือนในแอป (mirror push ทุกใบ — user ปัดซ้าย/กด × เพื่อลบ) ──
model CoachNotification {
  id        String    @id @default(cuid())
  memberId  String
  type      String    @default("system") // morning | nudge | insight | plan_adjust | system
  title     String
  body      String
  data      Json? // { screen, nudge, ... } สำหรับกดแล้วพาไปหน้าที่เกี่ยวข้อง
  readAt    DateTime?
  createdAt DateTime  @default(now())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("coach_notifications")
}

model BehaviorInsight {
  id         String   @id @default(cuid())
  memberId   String
  periodType String // "weekly" | "monthly"
  periodKey  String // "2026-W30"
  metric     String // sodium_trend | protein_gap | sleep_avg | adherence | weight_trend
  value      Json
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, periodType, periodKey, metric])
  @@index([memberId])
  @@map("behavior_insights")
}

// ── AI Coach: แผนรายวัน (ออกกำลังกาย + อาหาร) — เฟส 1 ──
model DailyPlan {
  id                String   @id @default(cuid())
  memberId          String
  date              DateTime // วันที่ของแผน (BKK date เก็บ 00:00 UTC ของวันนั้น -7)
  exercisePlan      Json // {title, durationMin, items:[{name,sets?,reps?,minutes?,note}], caloriesTarget}
  mealPlan          Json // {meals:[{slot,menu,ingredients?,kcal,protein,carbs,fat,sodium?,sugar?}], totalKcal}
  aiNote            String? // เหตุผล/การปรับแผนของ AI
  weekNote          String? // โน้ตโค้ชหัวสัปดาห์ — เล่าว่าสัปดาห์นี้ปรับอะไรเพราะอะไร (ตัวเลขจากโค้ดล้วน)
  status            String   @default("planned") // planned | done | partial | skipped
  exerciseDone      Boolean  @default(false)
  mealsDone         Json? // {"เช้า":true,...}
  exerciseItemsDone Json? // {"ชื่อท่า":true,...} ติ๊กรายท่า (Coach native)
  generatedAt       DateTime @default(now())
  weekBatchId       String? // ผูกชุดที่ gen พร้อมกัน ใช้ตอน regenerate
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([memberId, date])
  @@map("daily_plans")
}

// ── AI Coach: กันส่ง push ซ้ำต่อวัน — เฟส 2 ──
model CoachDispatchLog {
  id        String   @id @default(cuid())
  memberId  String
  date      DateTime // BKK date (00:00 UTC-7)
  type      String // morning | ...
  createdAt DateTime @default(now())

  @@unique([memberId, date, type])
  @@index([memberId, date])
  @@map("coach_dispatch_logs")
}

// ── AI Coach: ประวัติการปรับแผนอัตโนมัติ — เฟส 5 ──
model PlanAdjustment {
  id           String   @id @default(cuid())
  memberId     String
  date         DateTime @default(now())
  reason       String // เหตุผลที่ปรับ (plateau / on-track / ...)
  prevCalories Int?
  newCalories  Int?
  detail       Json? // {weightTrend, adherence, note}
  createdAt    DateTime @default(now())

  @@index([memberId, date])
  @@map("plan_adjustments")
}

model AiRecommendation {
  id           String   @id @default(cuid())
  memberId     String   @unique
  message      String
  context      Json?
  date         DateTime @default(now())
  requestCount Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

model MealLog {
  id          String           @id @default(cuid())
  memberId    String
  name        String
  weight      Float?
  multiplier  Float            @default(1)
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  sodium      Float?
  sugar       Float?
  imageUrl    String?
  ingredients String?
  via         String           @default("manual") // photo | barcode | voice | manual
  /// บันทึกนี้ตัดมาจากคลังอาหารของสมาชิกใบไหน — ลบบันทึกแล้วต้องคืนของกลับเข้าคลัง
  stockId     String?
  date        DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  stock       MemberFoodStock? @relation(fields: [stockId], references: [id], onDelete: SetNull)

  @@index([memberId, date])
  @@map("meal_logs")
}

model WeightLog {
  id        String   @id @default(cuid())
  memberId  String
  weight    Float
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@map("weight_logs")
}

model WaterLog {
  id        String   @id @default(cuid())
  memberId  String
  amount    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@map("water_logs")
}

/// คลังท่าออกกำลังกาย — ย้ายจาก exerciseCatalog.ts เข้า DB เพื่อให้แอดมินเพิ่มท่า/ใส่รูป/คลิปเองได้
/// key ต้องตรงกับคลังโค้ดเดิม (แผนเก่า/ตรรกะ snapExercises อ้างชื่อจาก key เหล่านี้)
model Exercise {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  /// ชื่อสากลภาษาอังกฤษ (Bodyweight Squat / Dumbbell Row) — ใช้ค้นในหลังบ้าน + หาคลิปอ้างอิง
  /// null ได้: แถวเก่าที่แอดมินเพิ่มเองยังไม่มีชื่ออังกฤษ (seed เติมให้เฉพาะที่ยังว่าง)
  nameEn    String?
  kind      String   @default("strength") // cardio | strength | mobility
  equipment String   @default("none") // none | home | gym
  impact    String   @default("low") // low | high
  unit      String   @default("reps") // reps | minutes
  met       Float    @default(4)
  muscles   String?
  /// วิธีทำ/ทิปฟอร์ม — โชว์ในชีต "ดูท่า" ของแอป
  cue       String?
  images    String[] @default([])
  /// ลิงก์ YouTube — แอปทำเป็นสไลด์คลิปเหมือนเมนูอาหาร
  videoUrl  String?
  /// ท่าที่แอดมินเพิ่มเอง (ลบจริงได้) — ท่ามาตรฐานปิดใช้งานได้อย่างเดียว (แผน/ตรรกะยังอ้างถึง)
  isCustom  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ── metadata สำหรับ engine เทรน (เฟส A) ──
  /// pattern = รูปแบบการเคลื่อนไหว ใช้หา "ท่าแทน" ตอน user เจ็บ/ไม่มีอุปกรณ์ (ไม่มี pattern = แทนกันมั่วไม่ได้)
  pattern          String? // squat|hinge|push_h|push_v|pull_h|pull_v|lunge|core|carry|cardio|mobility
  primaryMuscles   String[] @default([])
  /// ใส่น้ำหนักเพิ่มได้จริง → progression เดินด้วย "กิโล" · false = เดินด้วยบันไดความยาก/ครั้ง
  loadable         Boolean  @default(false)
  equipmentNeeded  String[] @default([]) // dumbbell|barbell|kettlebell|band|bench|pullup_bar|machine|treadmill|bike — ว่าง = ตัวเปล่า
  difficulty       Int      @default(2) // 1-5 ใช้เรียงบันไดในกลุ่มเดียวกัน
  /// ท่ากลุ่มเดียวกัน = บันไดความยาก (wall→knee→full) · ห้ามปนท่า impact สูงกับต่ำในบันไดเดียว
  progressionGroup String?
  commonMistakes   String?

  @@map("exercises")
}

/// คลังอุปกรณ์รายชิ้นของสมาชิก — แทน Member.equipment ที่มีแค่ 3 ค่า (none/home/gym)
/// incrementKg คือหัวใจ: ดัมเบลชุด 2-24 กก. ก้าว 2 → สั่งขึ้นน้ำหนัก 16→18 ไม่ใช่ 16→17.5 ที่ user ทำตามไม่ได้
model MemberEquipment {
  id          String   @id @default(cuid())
  memberId    String
  type        String // dumbbell|barbell|kettlebell|band|bench|pullup_bar|machine|treadmill|bike|full_gym
  variant     String? // fixed|adjustable
  minKg       Float?
  maxKg       Float?
  incrementKg Float?
  isPair      Boolean  @default(true)
  createdAt   DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_equipment")
}

/// บันทึกรายเซ็ต (Workout Player) — ตารางที่ engine progression ทั้งหมดกินเป็นอาหาร
/// ExerciseLog ยังอยู่เหมือนเดิมในฐานะ "สรุปต่อท่า" ของไทม์ไลน์/วงแหวน (สร้างจากการรวมยอดตารางนี้)
model SetLog {
  id             String   @id @default(cuid())
  memberId       String
  planId         String? // เล่นนอกแผนได้ → ว่างได้
  exerciseKey    String
  /// snapshot ชื่อ ณ ตอนบันทึก — แอดมินเปลี่ยนชื่อท่าใน DB ได้ แต่บันทึกเก่าต้องอ่านออกเสมอ
  exerciseName   String
  setNo          Int
  targetWeightKg Float?
  targetReps     Int?
  targetSec      Int?
  actualWeightKg Float?
  actualReps     Int?
  actualSec      Int?
  feel           String? // too_easy|easy|good|hard|too_hard
  rpe            Float? // 1-10 โหมด advanced
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, exerciseKey, date])
  @@index([memberId, date])
  @@map("set_logs")
}

/// สถานะ progression ต่อท่า (เฟส B) — "สมอง" ของ engine #3
/// ทุกค่าในตารางนี้ derive จาก SetLog ได้เสมอ (progressionStore คิดใหม่ทุกครั้งที่บันทึกเซ็ต)
/// เก็บไว้เพราะ SetLog ย้อนหลังไกลกว่าหน้าต่างที่ API อ่าน — กติกา "นิ่ง 3 สัปดาห์ = พักฟื้น" ต้องจำข้ามหน้าต่างได้
model ProgressionState {
  id            String   @id @default(cuid())
  memberId      String
  exerciseKey   String
  /// e1RM (Epley) จากเซ็ตที่ดีที่สุดล่าสุด — ท่าที่ใส่น้ำหนักได้เท่านั้น
  e1rmKg        Float?
  /// ตำแหน่งในบันได progressionGroup (0 = ท่าง่ายสุดของกลุ่ม) — ท่าที่ไม่มีบันได = null
  ladderLevel   Int?
  lastWeightKg  Float?
  lastReps      Int?
  lastSets      Int?
  /// บวก = สัปดาห์ที่ทำได้ตามเป้าติดกัน · ลบ = สัปดาห์ที่ทำไม่ไหวติดกัน (ใช้กติกาลดบันได)
  successStreak Int      @default(0)
  /// สัปดาห์ที่ตัวเลขไม่ขยับติดกัน — ครบ 3 = สั่งสัปดาห์พักฟื้น
  stallCount    Int      @default(0)
  updatedAt     DateTime @updatedAt
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, exerciseKey])
  @@index([memberId])
  @@map("progression_states")
}

/// Check-in ความพร้อมรายวัน (เฟส C) — อาหารของ engine #4 Readiness
/// ถามแค่ 2 ข้อ (energy/soreness) + จุดที่ปวด — ที่เหลือ (HRV/RHR/นอน) อ่านจาก Watch ที่ซิงก์อยู่แล้ว
/// เก็บ snapshot ค่าที่ใช้คิดไว้ด้วย เพราะ DailyMetric ถูกเขียนทับได้ตลอดวัน แต่คะแนนที่ user เห็นต้องอธิบายย้อนหลังได้
model ReadinessCheckin {
  id        String   @id @default(cuid())
  memberId  String
  /// วัน BKK (UTC midnight ของวันนั้น -7) — กติกาเดียวกับ DailyPlan.date
  date      DateTime
  /// 1-5 พลังงาน/แรงใจวันนี้ (รวม motivation+stress ตาม ENGINE §5.2)
  energy    Int?
  /// 1-5 ปวดกล้ามเนื้อแค่ไหน (5 = ปวดมาก)
  soreness  Int?
  /// จุดที่ปวด เช่น knee|back|shoulder — ใช้เลือกว่าจะลด pattern ไหนก่อน
  soreAreas String[] @default([])

  // ── snapshot ค่าที่ใช้คิดคะแนน ณ ตอน check-in ──
  hrvMs    Float?
  rhr      Int?
  sleepMin Int?

  /// 0-100 · null = ยังไม่มีข้อมูลพอจะให้คะแนน (ห้ามแต่งเลขให้)
  score      Int?
  band       String? // full | normal | reduced | recovery
  /// ปรับแผนของวันนี้ตามคะแนนไปแล้วหรือยัง
  applied    Boolean   @default(false)
  appliedAt  DateTime?
  /// สำเนา exercisePlan ก่อนปรับ — undo ต้องคืนของเดิมได้เป๊ะ (ไม่ใช่ "คิดย้อนกลับ" ซึ่งพลาดได้)
  planBackup Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([memberId, date])
  @@map("readiness_checkins")
}

/// โปรไฟล์เทรน (WO-PT-D §S1 · WO-PT-ENGINE §3) — คนละเรื่องกับ FoodProfile
/// นี่คือ "เขาอยากได้อะไร ทำได้แค่ไหน ว่างวันไหน" ที่ generator ต้องใช้ก่อนจะจัดท่าให้ใครสักคน
model TrainingProfile {
  memberId         String   @id
  primaryGoal      String // fat_loss|muscle_gain|strength|endurance|general|athletic
  secondaryGoals   String[] @default([])
  /// strength|hypertrophy|fatloss_hybrid|endurance|athletic|balanced · null = ให้ระบบเลือกตาม goal
  style            String?
  daysPerWeek      Int      @default(3)
  sessionMin       Int      @default(45)
  trainDays        String[] @default([]) // ["mon","wed","fri"] — ว่าง = กระจายให้เองตาม daysPerWeek
  preferredTime    String? // morning|afternoon|evening|"06:00-07:00"
  likes            String[] @default([])
  /// เลี่ยงถ้ามีตัวแทน pattern เดียวกัน (soft) — ต่างจาก InjuryLimitation ที่ตัดทิ้งเสมอ (hard)
  dislikes         String[] @default([])
  jobType          String? // desk|standing|physical
  stress           Int? // 1-5
  waistCm          Float?
  bodyFatPct       Float?
  /// เคยเทรนมานานแค่ไหน — ตัวคูณความเร็ว progression (มือใหม่ก้าวถี่กว่า)
  experienceMonths Int?

  /// สัปดาห์สอบเทียบ (ENGINE §5.1): true = ยังเก็บ feel อยู่ → น้ำหนักเบา reps กลางช่วง
  /// เคลียร์เองเมื่อครบ 7 วันนับจาก calibrationStartedAt (คิดตอนอ่าน ไม่มี cron)
  calibration          Boolean  @default(true)
  /// หมุดเวลาเริ่มสอบเทียบ — แยกจาก updatedAt เพราะแก้โปรไฟล์กลางสัปดาห์ต้องไม่รีเซ็ตนาฬิกา 7 วัน
  calibrationStartedAt DateTime @default(now())
  /// คำตอบ PAR-Q 3 ข้อ + answeredAt (+ clearedAt เมื่อ user ยืนยันว่าปรึกษาแพทย์แล้ว)
  parq                 Json?
  /// ตอบ "ใช่" ข้อใดข้อหนึ่ง = true → intensityCap = low จนกว่าจะปลด
  parqFlag             Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("training_profiles")
}

/// อาการบาดเจ็บแบบโครงสร้าง (WO-PT-ENGINE §3 ข้อ 9)
/// CoachMemory kind=injury ยังอยู่ในฐานะ "ความจำที่โค้ชเอาไปคุย" แต่ตัวกรองท่าต้องอ่านจากตารางนี้
/// (ข้อความอิสระกรองท่าไม่ได้จริง — "เข่าซ้ายเจ็บตอนลงน้ำหนัก" ไม่ตรงกับชื่อท่าใดเลย)
model InjuryLimitation {
  id            String    @id @default(cuid())
  memberId      String
  area          String // shoulder|knee|back|hip|ankle|wrist|neck|other
  severity      String    @default("caution") // caution (ลดน้ำหนัก) | avoid (ตัด pattern ทิ้ง)
  avoidPatterns String[]  @default([]) // ["squat","push_v"] — map กับ Exercise.pattern
  avoidKeys     String[]  @default([]) // ระบุรายท่า
  note          String?
  active        Boolean   @default(true)
  /// อาการชั่วคราว ("วันนี้ปวดเข่า" = 7 วัน) — ถึงเวลาแล้วถือว่าไม่มีผล โดยไม่ต้องรอ user มาปิดเอง
  /// 🔴 ทุกจุดที่อ่านต้องกรอง active && (expiresAt = null || expiresAt > now)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, active])
  @@map("injury_limitations")
}

model ExerciseLog {
  id        String   @id @default(cuid())
  memberId  String
  name      String
  type      String?
  duration  Int
  calories  Float
  intensity String?
  note      String?
  source    String   @default("manual") // manual | healthkit | watch | ai_photo
  sourceId  String? // dedup กับ HealthKit/Watch
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@map("exercise_logs")
}

model CartItem {
  id           String      @id @default(cuid())
  memberId     String
  foodId       String
  restaurantId String?
  quantity     Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  food         Food        @relation(fields: [foodId], references: [id], onDelete: Cascade)
  member       Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([memberId, foodId])
  @@map("cart_items")
}

model Address {
  id          String              @id @default(cuid())
  memberId    String
  label       String?
  name        String
  phone       String
  address     String
  subDistrict String?
  district    String?
  province    String
  postalCode  String
  note        String?
  isDefault   Boolean             @default(false)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  orders      Order[]
  enrollments ProgramEnrollment[]

  @@index([memberId])
  @@map("addresses")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  memberId        String?
  restaurantId    String?
  addressId       String?
  deliveryName    String?
  deliveryPhone   String?
  deliveryAddress String?
  coursePlan      String?
  totalDays       Int?
  totalPrice      Float       @default(0)
  deliveryFee     Float       @default(0)
  discount        Float       @default(0)
  discountType    String?
  discountValue   Float?
  packageName     String?
  finalPrice      Float?
  status          String      @default("pending")
  note            String?
  trackingNumber  String?
  carrier         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  address         Address?    @relation(fields: [addressId], references: [id])
  member          Member?     @relation(fields: [memberId], references: [id])
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([memberId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  foodId    String
  foodName  String
  price     Float
  quantity  Int     @default(1)
  dayNumber Int?
  mealType  String?
  calories  Float?
  food      Food    @relation(fields: [foodId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Restaurant {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  logoUrl         String?
  coverUrl        String?
  sellType        String      @default("both")
  deliveryFee     Float       @default(0)
  deliveryPerMeal Float       @default(0)
  minOrder        Float       @default(0)
  isActive        Boolean     @default(true)
  order           Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cartItems       CartItem[]
  categories      Category[]
  foods           Food[]
  orders          Order[]
  packages        Package[]
  promotions      Promotion[]

  @@map("restaurants")
}

model Category {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  color        String      @default("#4CAF50")
  isActive     Boolean     @default(true)
  order        Int         @default(0)
  restaurantId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foods        Food[]

  @@map("categories")
}

model Food {
  id             String             @id @default(cuid())
  sku            String? // รหัสสินค้า
  name           String
  description    String?
  ingredients    String[]           @default([])
  imageUrl       String?
  /// true = รูปนี้ AI สร้างให้ ไม่ใช่ภาพถ่ายกล่องจริง → ทุกที่ที่โชว์ต้องติดป้าย "ภาพตัวอย่าง"
  /// อัปรูปจริงทับเมื่อไร ระบบเคลียร์ธงนี้ให้เอง
  imageIsAi      Boolean            @default(false)
  images         String[]           @default([])
  /// ลิงก์ YouTube Shorts ของเมนูนี้ — แอปขึ้นปุ่ม ▶ บนรูปให้กดดู
  /// เก็บ URL ดิบที่แอดมินวางมา แล้วให้ฝั่ง server แกะ videoId เอง (วางแบบไหนก็ได้)
  videoUrl       String?
  price          Float
  discountPrice  Float?
  badge          String?
  calories       Float
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float?
  sugar          Float?
  sodium         Float?
  servingSize    Float?
  servingUnit    String?
  warning        String?
  isActive       Boolean            @default(true)
  order          Int                @default(0)
  categoryId     String
  restaurantId   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  cartItems      CartItem[]
  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant     Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  memberStocks   MemberFoodStock[]
  promotionGifts PromotionGift[]
  promotionItems PromotionItem[]
  calendarItems  MenuCalendarItem[]
  recipe         RecipeItem[]

  @@map("foods")
}

/// วัตถุดิบ 1 อย่างที่ครัวชั่งได้จริง — โภชนาการเก็บ "ต่อ 100 ก./มล." หน่วยเดียวทั้งระบบ
/// 🔴 ต้องเป็นต่อ 100 เสมอ ไม่ใช่ต่อหน่วยบริโภค ไม่งั้นคิด "อกไก่ 100→190 ก." ไม่ได้
///    (ต่างจาก food_catalog ที่เก็บต่อจาน — คลังนั้นเอาไว้ช่วยกรอก ไม่ได้ใช้คิดสูตร)
model Ingredient {
  id            String  @id @default(cuid())
  name          String  @unique
  /// g = ชั่งเป็นกรัม · ml = ตวง · pc = นับชิ้น/ฟอง (ใส่ gramsPerPiece ด้วย)
  unit          String  @default("g")
  /// น้ำหนักต่อชิ้นเมื่อ unit = pc (ไข่ 1 ฟอง ≈ 50 ก.) — ใช้แปลงกลับเป็นกรัมตอนคิด
  gramsPerPiece Float?
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  fiber         Float?
  sodium        Float?
  sugar         Float?
  /// บทบาทตั้งต้นเวลาเอาไปใส่สูตร — protein | carb | veg | fat | other
  defaultRole   String  @default("other")
  /// ครัวชั่งละเอียดได้แค่ไหน — เนื้อ/ข้าว 10 ก. · ซอส/เครื่องปรุง 5 ก.
  stepGrams     Int     @default(10)
  /// true = ตัวเลขยังไม่ได้ยืนยันโดยครัว (เช่นเพิ่งดึงมาช่วยกรอกจากคลังอาหาร)
  isEstimate    Boolean @default(true)
  /// ที่มาของตัวเลข เขียนเป็นข้อความ เช่น "ฉลากข้างถุง" / "คลังอาหาร: อกไก่ย่าง 100 กรัม"
  source        String?
  isActive      Boolean @default(true)

  // ── ของที่ลูกค้าเห็นตอนจัดชามเองในแอป (จอสั่งอาหาร 6 ขั้น) ────────────────
  /// ชื่ออังกฤษที่โชว์ใต้ชื่อไทยในแอป
  nameEn       String?
  /// ชื่อที่โชว์ในแอป ถ้าต่างจากชื่อในคลัง — ของเดียวกันที่ขายคนละขั้นต้องแยกแถว
  /// (ข้าวโพดเป็นฐาน 120 ก. กับข้าวโพดเป็นผัก 70 ก. คนละราคา) แต่ลูกค้าควรเห็นแค่ "ข้าวโพด"
  displayName  String?
  /// รูปวัตถุดิบ — /uploads/ingredients/xxx.jpg
  imageUrl     String?
  /// ขั้นที่ลูกค้าเลือกตัวนี้ได้: base|protein|veggies|toppings|sauce|finish
  /// null = เป็นวัตถุดิบหลังบ้านอย่างเดียว ไม่โผล่ในจอสั่งอาหาร
  bowlStep     String?
  /// ปริมาณต่อ 1 ที่ (portion) หน่วยเดียวกับ unit — ใช้แปลงค่าต่อ 100 ให้เป็นต่อ 1 ที่
  portionSize  Float?
  /// ราคาที่บวกเพิ่มต่อ 1 ที่ (บาท) — 0 = รวมอยู่ในราคาฐานของชามแล้ว
  portionPrice Int       @default(0)
  /// สารก่อภูมิแพ้ที่ต้องกันคนแพ้ — shrimp|fish|egg|milk|soy|wheat|peanut|treenut|sesame|shellfish
  allergens    String[]  @default([])
  /// ลำดับที่โชว์ในขั้นนั้น (น้อยขึ้นก่อน)
  sortOrder    Int       @default(0)
  /// ของหมดชั่วคราว — ครัวกดปุ่มเดียวแล้วหายจากแอปทันที (ต่างจาก isActive ที่แปลว่าเลิกขาย)
  soldOut      Boolean   @default(false)
  /// เวลาที่กดว่าหมด — ไว้ให้ครัวเห็นว่าค้างมากี่วันแล้ว
  soldOutAt    DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  recipeItems RecipeItem[]

  @@index([isActive, name])
  @@index([bowlStep, sortOrder])
  @@map("ingredients")
}

/// สูตรมาตรฐาน 1 บรรทัด = วัตถุดิบ 1 อย่างในกล่องมาตรฐาน 1 กล่อง
/// เมื่อเมนูมีสูตรครบ โภชนาการของกล่อง = ผลรวมของสูตร (ไม่ใช่ตัวเลขที่กรอกมือ)
model RecipeItem {
  id           String     @id @default(cuid())
  foodId       String
  ingredientId String
  /// protein | carb | veg | fat | other — ตัวคิดจานใช้บทบาทนี้เลือกว่าจะขยายตัวไหนเพื่อไล่มาโครตัวไหน
  role         String     @default("other")
  /// ปริมาณมาตรฐานต่อกล่อง (กรัม/มล. — ถ้าวัตถุดิบเป็น pc ให้ใส่จำนวนชิ้น)
  baseAmount   Float
  /// false = ตายตัวทุกคน (ซอส/เครื่องปรุงที่เพิ่มแล้วเค็มเกิน)
  scalable     Boolean    @default(true)
  /// เพดานที่ครัวยอมให้ปรับ — ว่าง = ใช้ค่ากลาง 0.5–2.5 เท่าของมาตรฐาน
  minAmount    Float?
  maxAmount    Float?
  note         String?
  order        Int        @default(0)
  food         Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([foodId, ingredientId])
  @@index([foodId])
  @@map("recipe_items")
}

model Package {
  id            String      @id @default(cuid())
  name          String
  description   String?
  imageUrl      String?
  days          Int         @default(7)
  mealsPerDay   Int         @default(3)
  requiredItems Int         @default(1)
  price         Float       @default(0)
  discountType  String? // "percent" | "fixed" | null (optional)
  discountValue Float? // optional discount value
  freeItems     Int         @default(0) // จำนวนเมนูแถม
  isActive      Boolean     @default(true)
  order         Int         @default(0)
  restaurantId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("packages")
}

model Promotion {
  id            String          @id @default(cuid())
  name          String
  description   String?
  imageUrl      String?
  type          String
  discountType  String?
  discountValue Float?
  minQuantity   Int             @default(1)
  minAmount     Float?
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean         @default(true)
  restaurantId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  gifts         PromotionGift[]
  items         PromotionItem[]
  restaurant    Restaurant?     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("promotions")
}

model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  foodId      String
  quantity    Int       @default(1)
  food        Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, foodId])
  @@map("promotion_items")
}

model PromotionGift {
  id          String    @id @default(cuid())
  promotionId String
  foodId      String
  quantity    Int       @default(1)
  food        Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, foodId])
  @@map("promotion_gifts")
}

model ArticleCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String    @default("#4CAF50")
  icon        String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@map("article_categories")
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Article {
  id                 String           @id @default(cuid())
  title              String
  slug               String           @unique
  excerpt            String?
  content            String?
  coverImage         String?
  ogImage            String?
  categoryId         String?
  tags               String?
  authorId           String?
  isFeatured         Boolean          @default(false)
  status             ArticleStatus    @default(DRAFT)
  publishedAt        DateTime?
  scheduledFor       DateTime?
  views              Int              @default(0)
  readTime           Int              @default(5)
  order              Int              @default(0)
  metaDescription    String?
  focusKeyword       String?
  canonicalUrl       String?
  recipeData         Json?
  imagePrompt        String?
  socialCard         Json?
  socialImage        String?
  socialDispatchedAt DateTime?
  socialPostId       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  category           ArticleCategory? @relation(fields: [categoryId], references: [id])
  authorStaff        Staff?           @relation("ArticleAuthor", fields: [authorId], references: [id])
  socialDispatches   SocialDispatch[]

  @@index([status, publishedAt])
  @@index([status, scheduledFor])
  @@index([categoryId, status])
  @@index([socialDispatchedAt])
  @@map("articles")
}

model SocialDispatch {
  id           String    @id @default(cuid())
  articleId    String
  article      Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sharkPostId  String?
  channelIds   String[]
  status       String // PENDING | DISPATCHED | FAILED
  scheduledAt  DateTime
  dispatchedAt DateTime?
  error        String?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([articleId])
  @@index([status])
  @@map("social_dispatches")
}

model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  youtubeId   String
  thumbnail   String?
  category    String?
  duration    String?
  views       Int      @default(0)
  likes       Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("videos")
}

model Staff {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  phone     String?
  avatarUrl String?
  roleId    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      Role      @relation(fields: [roleId], references: [id])
  articles  Article[] @relation("ArticleAuthor")

  @@map("staff")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff[]

  @@map("roles")
}

model MemberType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String  @default("#4CAF50")

  // AI Limit Mode: "by_type" = แยกตามประเภท, "combined" = รวมทั้งหมด
  aiLimitMode       String @default("by_type")
  totalDailyAiLimit Int    @default(15) // ใช้เมื่อ aiLimitMode = "combined"

  // AI Usage Limits (0 = unlimited) - ใช้เมื่อ aiLimitMode = "by_type"
  dailyPhotoLimit            Int @default(3) // ถ่ายรูปอาหาร
  dailyAiAnalysisLimit       Int @default(3) // วิเคราะห์อาหารจากรูป
  dailyAiTextAnalysisLimit   Int @default(3) // วิเคราะห์อาหารจากข้อความ
  dailyAiRecommendLimit      Int @default(3) // AI คำแนะนำ
  dailyExerciseAnalysisLimit Int @default(3) // วิเคราะห์การออกกำลังกาย
  dailyMenuSelectLimit       Int @default(3) // AI เลือกเมนู
  dailyScanLimit             Int @default(5) // สแกน Barcode
  dailyChatLimit             Int @default(20) // AI ตอบแชท LINE (เฟส 3)

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Course Duration (0 = unlimited)
  courseDuration Int @default(7)

  // Coaching Times
  morningCoachTime   String @default("07:00")
  lunchReminderTime  String @default("11:30")
  dinnerReminderTime String @default("17:30")
  eveningSummaryTime String @default("20:00")

  // Water Reminder
  waterReminderTimes String @default("09:00,11:00,14:00,16:00")

  // Weekly
  weeklyInsightsTime String @default("09:00")

  // Inactive threshold (days)
  inactiveReminderDays Int @default(2)

  members Member[]

  @@map("member_types")
}

model ProgressPhoto {
  id         String   @id @default(cuid())
  memberId   String
  imageUrl   String
  weight     Float?
  weekNumber Int
  note       String?
  takenAt    DateTime @default(now())
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, weekNumber])
  @@map("progress_photos")
}

model LineConversation {
  id            String        @id @default(cuid())
  lineUserId    String        @unique
  displayName   String?
  pictureUrl    String?
  statusMessage String?
  lastMessageAt DateTime      @default(now())
  unreadCount   Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      LineMessage[]

  @@index([lastMessageAt])
  @@map("line_conversations")
}

model LineMessage {
  id               String           @id @default(cuid())
  conversationId   String
  lineMessageId    String?          @unique
  type             String           @default("text")
  direction        String
  content          String?
  stickerPackageId String?
  stickerId        String?
  previewUrl       String?
  fileName         String?
  fileSize         Int?
  duration         Int?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  conversation     LineConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("line_messages")
}

model PaymentAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  qrCodeUrl     String?
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_accounts")
}

model BarcodeProduct {
  id          String               @id @default(cuid())
  barcode     String               @unique
  name        String
  brand       String?
  imageUrl    String?
  servingSize Float?
  servingUnit String?              @default("g")
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  sodium      Float?
  sugar       Float?
  fiber       Float?
  source      String               @default("manual")
  verified    Boolean              @default(false)
  scanCount   Int                  @default(1)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  scanHistory BarcodeScanHistory[]

  @@index([barcode])
  @@index([name])
  @@map("barcode_products")
}

model BarcodeScanHistory {
  id               String         @id @default(cuid())
  memberId         String
  barcodeProductId String
  quantity         Float          @default(1)
  createdAt        DateTime       @default(now())
  barcodeProduct   BarcodeProduct @relation(fields: [barcodeProductId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("barcode_scan_history")
}

/// คลังอาหารรายคน — แอดมินกดเพิ่มให้ลูกค้าหลังรับออเดอร์ในแชท
///
/// 🔴 เพิ่มได้เฉพาะ "เมนูของครัว" (Food) เท่านั้น (เจ้าของเคาะ 26 ส.ค. 69)
/// 🔴 โภชนาการ/ชื่อ/รูป เก็บเป็นสำเนาไว้ที่นี่ — เมนูครัวแก้สูตรทีหลังต้องไม่กระทบของที่ลูกค้าถืออยู่
/// 🔴 remaining ลดเมื่อลูกค้ากดบันทึกจาก "คลังอาหารของฉัน" เท่านั้น
///    (ลบบันทึกทิ้ง = คืนของเข้าคลัง — ดู MealLog.stockId)
model MemberFoodStock {
  id        String    @id @default(cuid())
  memberId  String
  foodId    String
  /// สำเนาไว้ตอนเพิ่ม ไม่อ่านสดจากเมนูครัว
  name      String
  imageUrl  String?
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  sodium    Float?
  sugar     Float?
  /// กล่อง | ชาม | จาน | ถุง | ขวด | แก้ว | ชิ้น | ห่อ | ที่
  unit      String    @default("กล่อง")
  /// จำนวนที่เพิ่มเข้ามาทั้งหมด (ไว้ดูย้อนหลังว่าใช้ไปเท่าไร)
  quantity  Int
  /// คงเหลือตอนนี้ — 0 = ไม่โผล่ในแอปแล้ว แต่ยังอยู่ในหลังบ้านให้กดเติม
  remaining Int
  /// ไม่ใส่ก็ได้ (อาหารสดค่อยใส่)
  expiresAt DateTime?
  note      String?
  /// ใครเป็นคนเพิ่ม — เวลามีปัญหา "ของหายไปไหน" ต้องสาวกลับได้
  addedBy   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  food      Food      @relation(fields: [foodId], references: [id], onDelete: Restrict)
  mealLogs  MealLog[]

  @@index([memberId, remaining])
  @@map("member_food_stocks")
}

/// "วันนี้ไม่ได้กินมื้อนี้" — ผู้ใช้กดข้ามงานค้างของวันนั้น
/// 🔴 มีไว้เพื่อไม่ให้ระบบตื๊อคนที่ไม่กินมื้อเช้าเป็นปกติ (IF/อดมื้อเช้า)
///    ข้ามบ่อยพอ = เลิกถามมื้อนั้นไปเลย (ดู src/app/api/coach/todos/route.ts)
model TodoSkip {
  id        String   @id @default(cuid())
  memberId  String
  /// breakfast | lunch | dinner | water | ... (ตรงกับ key ของ todo)
  key       String
  /// วันตามปฏิทินไทย เก็บเป็น UTC midnight ของวันนั้น (กติกาเดียวกับ DailyPlan)
  date      DateTime
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, key, date])
  @@index([memberId, key, date])
  @@map("todo_skips")
}

model SystemSetting {
  id String @id @default("system")

  // AI Coach Global Settings
  aiCoachEnabled      Boolean @default(true)
  trialDays           Int     @default(7)
  trialMemberTypeId   String?
  generalMemberTypeId String?

  // Premium Upgrade Settings
  premiumPrice Int @default(299) // ราคาอัพเกรด Premium (บาท)
  premiumDays  Int @default(30) // จำนวนวัน Premium

  // Member Activity Status Settings
  inactiveDaysThreshold Int @default(7) // จำนวนวันที่ไม่เปิดแอปถึงจะเป็น Inactive
  gracePeriodDays       Int @default(2) // ส่งเตือนก่อนเปลี่ยนสถานะกี่วัน

  // LINE OA ที่ใช้รับออเดอร์อาหาร (เช่น "@goodfood") — ว่าง = ปุ่มสั่งในแอปยังไม่เปิด
  lineOaId String?

  // ราคาฐานของชามจัดเอง (บาท) — รวม base + ผัก + ซอส + ของโรยหน้าแล้ว
  // โปรตีน/ท็อปปิ้งบวกเพิ่มรายชิ้นตาม Ingredient.portionPrice
  bowlBasePrice  Int   @default(99)
  // เพดานจำนวน "ที่" ต่อขั้น — { base, protein, veggies, toppings, sauce, finish }
  // null = ใช้ค่าเริ่มต้นใน src/lib/bowl.ts
  bowlStepLimits Json?

  // ราคาเครดิต AI ต่อ action (โหมด combined) — null = ใช้ค่าเริ่มต้นในโค้ด (src/lib/aiCredits.ts)
  // { chat, photo, plan, barcode, textAnalysis, exerciseAnalysis, recommend, menuSelect }
  aiCreditCosts Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model SecretSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  valueEnc    String // AES-256-GCM: ivHex:cipherHex:tagHex
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("secret_settings")
}

model AiUsageLog {
  id        String   @id @default(cuid())
  memberId  String
  usageType String // "photo", "ai_analysis", "ai_text_analysis", "ai_recommend", "exercise_analysis", "menu_select", "scan"
  // เครดิตที่หักจริงของครั้งนั้น (โหมด combined) — เก็บติดแถวเพื่อให้ย้อนดูได้ว่าตอนนั้นราคาเท่าไหร่
  creditKey String? // chat | photo | plan | barcode | textAnalysis | exerciseAnalysis | recommend | menuSelect
  credits   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([memberId, usageType, createdAt])
  @@map("ai_usage_logs")
}

// ── Coach: คลังอาหารไทย deterministic (WO-B) ──
// ทำไมต้องมี: user กรอกอาหารเองบ่อยกว่าถ่ายรูป — ถ้าไม่มีคลัง ทุกครั้งต้องยิง AI (จ่าย OpenRouter)
// คนละโดเมนกับ model Food (เมนูขายของร้าน goodfood) จึงแยกตารางชัดเจน
model FoodCatalog {
  id         String   @id @default(cuid())
  name       String   @unique // ชื่อไทยมาตรฐาน
  aliases    String[] @default([]) // คำสะกดแปร/ชื่อเล่น/ชื่ออังกฤษที่คนไทยพิมพ์
  category   String
  portion    String // หน่วยบริโภคมาตรฐานภาษาคน เช่น "1 จาน (~350 ก.)"
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  sodium     Float?
  sugar      Float?
  isEstimate Boolean  @default(true)
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@map("food_catalog")
}

// ── Coach: คลิปสั้นสุขภาพจากช่อง YouTube ของ GoodFood ("คลิปสำหรับคุณวันนี้") ──
// cron /api/cron/video-sync (วันละครั้ง 05:10 น. ไทย) เติมตารางนี้ — แอปอ่านจาก DB เท่านั้น
// ไม่มีคอลัมน์ memberId: คลังคลิปเป็นของกลาง การคัดรายคนคำนวณสด (deterministic) ตอนเรียก API
model CoachVideo {
  videoId     String   @id // YouTube video id (เช่น 5p6-iO-sFHs)
  title       String
  description String?  @db.Text
  thumbnail   String
  publishedAt DateTime
  topics      String[] @default([]) // TopicKey: sodium|sugar|protein|sleep|weight|exercise (map จากคีย์เวิร์ด)
  isActive    Boolean  @default(true) // false = หายไปจากแหล่ง (กลับเป็น private) — ไม่ลบแถว เก็บประวัติไว้
  syncedAt    DateTime @updatedAt

  @@index([isActive, publishedAt])
  @@map("coach_videos")
}

// ══════════════════════════════════════════════════════════════════════
// ผูกปิ่นโต / นักโภชนาการส่วนตัว (14 ส.ค. 2026)
// แอปฟรี — รายได้มาจากการขายอาหารจริงผ่าน LINE OA
// ══════════════════════════════════════════════════════════════════════

/// ผลแบบสำรวจรสนิยมอาหาร — 1 แถวต่อสมาชิก
/// แยกจาก CoachMemory เพราะอันนั้นเป็นข้อความอิสระที่ AI เขียนเอง ค้น/กรองด้วย SQL ไม่ได้
/// ส่วนตัวนี้ต้องเอาไป "กรองเมนูจริง" ทุกครั้งที่จัดแผน จึงต้องเป็นคอลัมน์ที่ query ได้
model FoodProfile {
  id               String   @id @default(cuid())
  memberId         String   @unique
  /// 🔴 เรื่องความปลอดภัย — ต้องกรองออกก่อนเสมอ ไม่มีข้อยกเว้น
  allergies        String[] @default([])
  /// เนื้อสัตว์ที่ไม่กิน: หมู | วัว | ไก่ | ทะเล | ไม่กินเนื้อสัตว์
  avoidMeats       String[] @default([])
  /// 0 = ไม่กินเผ็ด · 1 = เผ็ดน้อย · 2 = เผ็ดกลาง · 3 = เผ็ดมาก
  spiceLevel       Int      @default(1)
  eatsVegetables   Boolean  @default(true)
  dislikedVeggies  String[] @default([])
  /// จัดจ้าน | กลมกล่อม | จืด
  tastePref        String?
  /// ไทย | อีสาน | ญี่ปุ่น | คลีน | ฝรั่ง | จีน ...
  cuisines         String[] @default([])
  /// มื้อที่อยากให้จัดให้: เช้า | กลางวัน | ว่าง | เย็น
  mealSlots        String[] @default(["เช้า", "กลางวัน", "เย็น"])
  /// เบาหวาน | ความดัน | ไต | ไขมันในเลือด — คุมโซเดียม/น้ำตาลเข้มขึ้น
  healthConditions String[] @default([])
  budgetPerDay     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("food_profiles")
}

/// แผนอาหารที่ออกแบบไว้ 1 ชุด (7 / 14 / 30 วัน) — ยังไม่ใช่ออเดอร์
/// ต้องเก็บเป็นตารางจริงเพราะ user ต้องกลับมาดู/เปลี่ยนเมนูได้ก่อนตัดสินใจสั่ง
model MealPlanDesign {
  id            String               @id @default(cuid())
  memberId      String
  days          Int
  /// draft = ยังแก้ได้ · ordered = สั่งแล้ว ล็อกไม่ให้แก้ · cancelled = ทิ้ง
  status        String               @default("draft")
  /// เป้าโภชนาการ ณ ตอนที่จัด (เก็บไว้เทียบย้อนหลัง — เป้าเปลี่ยนได้ทุกสัปดาห์)
  targetKcal    Int
  totalPrice    Float                @default(0)
  /// จำนวนวันที่จัดแล้วมาโครไม่เข้าเกณฑ์ ±15% — โชว์ให้ user รู้ตรง ๆ ไม่ปกปิด
  offTargetDays Int                  @default(0)
  orderId       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  member        Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items         MealPlanDesignItem[]
  swaps         MealSwap[]

  @@index([memberId, status])
  @@map("meal_plan_designs")
}

/// 1 มื้อในแผน — เก็บค่าโภชนาการ/ราคา ณ ตอนจัด (snapshot)
/// ราคา/สูตรอาหารเปลี่ยนได้ทีหลัง แต่ใบเสนอที่ user เห็นต้องไม่เปลี่ยนตามหลังบ้าน
model MealPlanDesignItem {
  id        String         @id @default(cuid())
  designId  String
  dayNumber Int
  /// เช้า | กลางวัน | ว่าง | เย็น
  slot      String
  foodId    String
  foodName  String
  imageUrl  String?
  price     Float
  servings  Int            @default(1)
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  sodium    Float?
  sugar     Float?
  /// เปลี่ยนเมนูนี้มาแล้วกี่ครั้ง — เยอะผิดปกติ = แผนวันนั้นไม่ตรงใจ
  swapCount Int            @default(0)
  design    MealPlanDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, dayNumber, slot])
  @@index([designId, dayNumber])
  @@map("meal_plan_design_items")
}

/// ประวัติการกดเปลี่ยนเมนู — สัญญาณเรียนรู้รสนิยมที่ตรงที่สุด
/// 🔴 ต้องเก็บ "เหตุผล" ด้วย: เบื่อ ≠ ไม่ชอบ
///    ถ้านับรวมกันหมด ระบบจะตัดเมนูที่ลูกค้าชอบทิ้งเพราะเพิ่งกินไป
model MealSwap {
  id         String          @id @default(cuid())
  memberId   String
  designId   String?
  dayNumber  Int?
  slot       String?
  fromFoodId String
  fromName   String
  toFoodId   String?
  toName     String?
  /// dislike = ไม่ชอบเมนูนี้ · bored = เพิ่งกินไป · variety = อยากลองอย่างอื่น
  reason     String          @default("dislike")
  createdAt  DateTime        @default(now())
  member     Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  design     MealPlanDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([memberId, fromFoodId])
  @@map("meal_swaps")
}

// ══════════════════════════════════════════════════════════════════════
// โปรแกรมปิ่นโต — ปฏิทินเมนู + สมาชิกโปรแกรม (17 ส.ค. 2026)
//
// 🔑 หลักคิดที่ทำให้ทั้งระบบนี้ถูก: เมนูผูกกับ "วันที่" ไม่ใช่ผูกกับ "ลูกค้า"
//    ครัวทำวันละชุดเดียวทุกคนกินเหมือนกัน → ต้นทุนคงที่ไม่ว่าจะมีลูกค้ากี่คน
//    ลูกค้าสมัครวันไหนก็ได้ ได้ครบ 7 วันเสมอ (คอร์ส = หน้าต่างที่เลื่อนบนปฏิทิน)
//
//    ทางเลือกที่ "ไม่" เอา: ให้แต่ละคนมีวันที่ 1-7 ของตัวเอง
//    เพราะครัวจะต้องทำ 7 เมนูพร้อมกันทุกวัน = พังเรื่องต้นทุน ซึ่งเป็นเหตุผลที่เปลี่ยนระบบมาแบบนี้
// ══════════════════════════════════════════════════════════════════════

/// เมนู 1 จาน ใน 1 วัน 1 มื้อ 1 สาย — admin กรอกล่วงหน้าให้ปฏิทินเต็มเสมอ
/// อ้าง Food ตรง ๆ ไม่ snapshot เพราะปฏิทินคือ "แผนที่ยังแก้ได้"
/// (snapshot เกิดตอนสร้าง OrderItem ซึ่งเป็นเอกสารที่ต้องไม่เปลี่ยนตามหลังบ้าน)
model MenuCalendarItem {
  id        String   @id @default(cuid())
  /// วันที่ให้บริการตามเวลาไทย — เก็บเป็น date ล้วนไม่มีเวลา จะได้ไม่โดน timezone เลื่อนวัน
  date      DateTime @db.Date
  /// standard | no_seafood | no_meat | vegetarian
  track     String
  /// เช้า | กลางวัน | ว่าง | เย็น
  slot      String
  foodId    String
  /// หมายเหตุถึงครัว เช่น "งดพริกสำหรับสายนี้"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  food      Food     @relation(fields: [foodId], references: [id])

  @@unique([date, track, slot])
  @@index([date])
  @@map("menu_calendar_items")
}

/// 1 คอร์สที่ลูกค้าซื้อ — ใช้ตอบคำถาม "วันนี้ต้องทำกี่กล่อง ของใครบ้าง"
model ProgramEnrollment {
  id           String   @id @default(cuid())
  memberId     String
  /// standard | no_seafood | no_meat | vegetarian
  track        String   @default("standard")
  /// วันแรกที่ได้รับอาหาร
  startDate    DateTime @db.Date
  /// วันสุดท้ายที่ได้รับอาหาร = startDate + totalDays - 1
  endDate      DateTime @db.Date
  totalDays    Int      @default(7)
  /// มื้อที่ซื้อ — บางคนรับแค่กลางวัน+เย็น
  slots        String[] @default(["เช้า", "กลางวัน", "เย็น"])
  /// active | completed | cancelled
  status       String   @default("active")
  price        Float    @default(0)
  orderId      String?
  addressId    String?
  deliveryNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  address      Address? @relation(fields: [addressId], references: [id])

  @@index([memberId, status])
  @@index([status, startDate])
  @@map("program_enrollments")
}

// ═══════════════════ Body Progress (BP-1 · WO-BODY §4) ═══════════════════
// 🔴 กติกาสถาปัตยกรรมของสามตารางนี้ (WO-BODY §5 — ข้อบังคับ ไม่ใช่ option):
//    path ในตารางนี้ชี้ไปที่ private dir (PRIVATE_DIR) เท่านั้น — ห้ามอยู่ใต้ public/uploads เด็ดขาด
//    (public/uploads ถูก nginx เสิร์ฟสาธารณะ + immutable cache 30 วัน = ใครมี URL ก็เปิดรูปร่างกายลูกค้าได้)
//    รูปออกจากระบบได้ทางเดียว: GET /api/coach/body-photo/[scanId]/[view] (เช็คเจ้าของ + no-store)

/// สแกนร่างกาย 1 ครั้ง = 2-3 ภาพ (หน้า/ข้าง/หลัง) ของวันเดียว
/// สแกนซ้ำวันเดิม = ทับของเดิม (@@unique([memberId, date])) — ไม่งั้นกราฟเทรนด์จะมีหลายจุดในวันเดียว
/// เสียงจากลูกค้าหลังทานแต่ละมื้อ — วัตถุดิบของครัวในการปรับรส/ปริมาณรายคน (เจ้าของสั่ง 23 ส.ค. 69)
model MealFeedback {
  id        String   @id @default(cuid())
  memberId  String
  foodId    String?
  foodName  String
  slot      String? // เช้า | กลางวัน | ว่าง | เย็น
  date      DateTime // วัน BKK (กติกาเดียวกับ DailyPlan.date)
  /// 1=ไม่อร่อย 2=เฉย ๆ 3=อร่อย
  taste     Int?
  /// 1=ไม่พอ(ยังหิว) 2=พอดี 3=เยอะไป(เหลือ)
  portion   Int?
  note      String?
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@index([foodId])
  @@map("meal_feedbacks")
}

model BodyScan {
  id       String   @id @default(cuid())
  memberId String
  /// วัน BKK (UTC midnight ของวันนั้น +7) — กติกาเดียวกับ DailyPlan.date / ReadinessCheckin.date
  date     DateTime

  /// 🔴 path สัมพัทธ์ใต้ PRIVATE_DIR เช่น "body/<memberId>/<scanId>-front.jpg"
  /// เก็บแบบสัมพัทธ์เพราะ mount point ต่างกันระหว่าง container (/app/private) กับ host (/var/lib/goodfood/private)
  frontPath String
  sidePath  String
  backPath  String?

  /// ส่วนสูงที่ใช้เป็นสเกลตอนคิด (ซม.) — null = ตอนสแกนโปรไฟล์ยังไม่มีส่วนสูง (BP-2 คิดค่าสัมบูรณ์ไม่ได้ แต่เก็บภาพ/landmark ไว้ reprocess ได้)
  heightCmUsed Float?
  /// good | ok | poor — ผลจาก bodyScanGate (poor ถูกปฏิเสธตั้งแต่ตอนอัปโหลด จึงไม่ควรมี poor ในตารางนี้)
  quality      String

  /// 33 จุด × ภาพ (ดิบจาก MediaPipe) — เก็บไว้ reprocess เมื่อสูตร BP-2 ดีขึ้น โดยไม่ต้องขอรูปใหม่จากลูกค้า
  landmarks Json
  /// ความกว้าง/ลึกดิบต่อระดับกายวิภาค — BP-1 เขียน {} ไว้ก่อน (BP-2 เป็นคนเติม)
  widthsPx  Json
  /// ค่าประมาณ (เอว/สะโพก/BF%/posture) พร้อมช่วง+confidence — BP-1 เขียน {} ไว้ก่อน (BP-2 เป็นคนเติม)
  estimates Json

  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([memberId, date])
  @@map("body_scans")
}

/// สายวัดจริงของลูกค้า — ground truth ที่แม่นกว่ากล้องเสมอ (WO-BODY §4)
/// ระบบต้องเลือกค่านี้ก่อนค่าที่ CV ประมาณ เมื่อมีทั้งคู่ในวันเดียวกัน
model BodyMeasurement {
  id       String   @id @default(cuid())
  memberId String
  /// วัน BKK (UTC midnight +7) เหมือน BodyScan.date
  date     DateTime
  /// waist | hip | chest | shoulder | arm_l | arm_r | thigh_l | thigh_r | calf_l | calf_r | neck
  site     String
  valueCm  Float
  /// tape = สายวัดมือ · scale = จากเครื่องชั่ง · cv = ระบบประมาณเอง (BP-2)
  source   String   @default("tape")

  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, site, date])
  @@index([memberId, date])
  @@map("body_measurements")
}

/// เป้าหมายรูปร่าง 1 อัน = 1 อัลบั้ม transformation (ดีไซน์ข้อ 22)
/// เก็บเป็นตัวเลขล้วน — ไม่มีภาพร่าง "ตัวเองในอนาคต" (การสร้างภาพนั้น = fabrication ห้ามทำ)
model BodyGoal {
  id       String @id @default(cuid())
  memberId String
  /// ชื่อที่ลูกค้าตั้งเอง เช่น "Summer Body 2026"
  label    String

  targetWeightKg Float?
  targetWaistCm  Float?
  /// ช่วง body fat ที่ตั้งเป้า (lo-hi) — เป้าเป็นช่วงเสมอ เพราะตัววัดให้ค่าเป็นช่วง
  targetBfLo     Float?
  targetBfHi     Float?

  /// สแกนตั้งต้นของอัลบั้มนี้ (ภาพ "before") — ไม่ผูก FK เพราะลบสแกนตั้งต้นได้โดยไม่ควรลบเป้าทิ้ง
  startScanId String?
  startedAt   DateTime @default(now())
  /// กี่สัปดาห์ถึงเป้า — คิดจากอัตราปลอดภัย (ลด 0.5-0.75 กก./สัปดาห์ · เอว ~0.5 ซม./สัปดาห์)
  targetWeeks Int?
  /// active | achieved | paused | cancelled
  status      String   @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@map("body_goals")
}

/// รายงานร่างกาย 4 สัปดาห์ (BP-3) — จุดเดียวในระบบ Body ที่มี LLM เข้ามาเกี่ยว
/// 🔴 stats = ตัวเลขที่ pipeline คิดเสร็จแล้วทั้งหมด · narrative = แค่ "คำเล่า" ของตัวเลขชุดนั้น
///    เก็บ stats ไว้คู่กันเสมอ เพื่อให้ตรวจย้อนได้ว่าย่อหน้านั้นพูดเกินตัวเลขไหม
model BodyReport {
  id       String @id @default(cuid())
  memberId String

  /// ช่วงของรายงาน (28 วัน) — periodEnd เป็นคีย์กันซ้ำของ cron ด้วย
  periodStart DateTime
  periodEnd   DateTime

  stats     Json
  narrative String
  /// llm | fallback — ต้องรู้ว่าใครเขียนย่อหน้านี้ เวลาไล่ปัญหาคุณภาพย้อนหลัง
  source    String @default("fallback")

  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, periodEnd])
  @@index([memberId, periodEnd])
  @@map("body_reports")
}

/// การเชื่อมบริการสุขภาพภายนอกของสมาชิก (Fitbit / Strava)
/// 🔴 ต่างจาก AuthIdentity: อันนั้นคือ "ล็อกอินด้วยอะไร" อันนี้คือ "ดึงข้อมูลจากที่ไหน"
///    คนหนึ่งอาจล็อกอินด้วย Apple แต่ดึงข้อมูลจาก Fitbit ก็ได้
/// 🔴 token เก็บแบบเข้ารหัส (AES-GCM ด้วย SECRETS_MASTER_KEY) เหมือน secret_settings
///    เพราะ access token ของ Fitbit เปิดอ่านข้อมูลสุขภาพย้อนหลังได้ทั้งบัญชี
model HealthConnection {
  id         String    @id @default(cuid())
  memberId   String
  /// fitbit | strava
  provider   String
  /// user id ฝั่งผู้ให้บริการ — ไว้ตรวจว่าเป็นบัญชีเดิมหรือเปลี่ยนคน
  externalId String
  tokenEnc   String
  refreshEnc String?
  expiresAt  DateTime?
  scope      String?
  /// ดึงข้อมูลถึงวันไหนแล้ว — cron จะดึงต่อจากนี้ ไม่ใช่ไล่ใหม่ทั้งหมดทุกครั้ง
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, provider])
  @@index([provider])
  @@map("health_connections")
}
